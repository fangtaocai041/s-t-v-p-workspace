# ── eon-workspace 环境配置 ──
# 复制此文件为 .env 并根据需要修改

# DeepSeek API (认知搜索引擎)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# GBIF (可选, 用于物种分布查询)
# 无需 key, 匿名访问有限额

# NCBI E-utilities (可选, 用于分类学查询)
# 无需 key, 每秒最多 3 次请求
# 如有 API key 可提升到 10 次/秒
NCBI_API_KEY=

# Prometheus (可选, 用于监控指标)
# 无需 key, 默认监听 9090 端口

# 日志级别
LOG_LEVEL=INFO
